# Copy to `.env.local` for local development, and set the same variable in your
# host's build environment (Netlify: Site settings -> Environment variables;
# GitHub Pages: a repository variable wired into .github/workflows/deploy.yml).
#
# Your Calendly scheduling link — in Calendly, open the event type and use
# "Copy link". When unset, the fallback in src/lib/data/calendly.ts is used.
VITE_CALENDLY_URL=https://calendly.com/your-handle/30min
